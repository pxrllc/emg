{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "outDir": "dist-electron",
        "rootDir": ".",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": [
        "electron-main/**/*"
    ],
    "exclude": [
        "src/**/*"
    ]
}