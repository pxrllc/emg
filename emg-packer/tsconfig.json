{
  "compilerOptions": {
    // target 未指定だと ES5 になり、Map/Set の for..of がすべて型エラーになる。
    // Vite も Electron も最新のエンジンなので、ES5 を前提にする理由はない。
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/**/*"
  ]
}